{
  "name": "labrecha",
  "version": "1.0.0",
  "private": true,
  "description": "La Brecha - Monorepo (scraper + API + web) de indicadores económicos y políticos de Argentina",
  "scripts": {
    "dev": "./scripts/run-local.sh",
    "dev:docker": "./scripts/run-docker.sh",
    "dev:infra": "./scripts/dev-infra.sh",
    "format": "npm run format:frontend",
    "format:frontend": "cd web && npm run format",
    "format:check": "npm run format:check:frontend",
    "format:check:frontend": "cd web && npm run format:check",
    "lint:frontend": "cd web && npm run lint",
    "lint": "npm run lint:frontend",
    "check": "npm run check:frontend",
    "check:frontend": "cd web && npm run check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "lint-staged": {
    "web/**/*.{js,jsx,ts,tsx,json,css}": ["npx biome check --write --no-errors-on-unmatched"]
  }
}
